# Supabase Postgres — use the Session pooler URI (IPv4); the direct db.<ref> host is IPv6-only.
# See README: "Supabase and Clerk".
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

AUTH_SECRET="replace-with-a-long-random-string"

# Only these campus addresses can sign up or sign in
NEXT_PUBLIC_CAMPUS_EMAIL_DOMAIN="uetpeshawar.edu.pk"
NEXT_PUBLIC_CAMPUS_NAME="UET Peshawar"

# Clerk (optional — unset means the built-in cookie sessions are used)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""

# Campus wall-clock zone used for all displayed/parsed times (server may run in UTC)
NEXT_PUBLIC_CAMPUS_TIMEZONE="Asia/Karachi"

# Required to run `npm run seed` / `npm run setup`, which wipe the database
# ALLOW_SEED_RESET=1
